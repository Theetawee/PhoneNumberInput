{
    "name": "Waanverse-PhoneNumberInput",
    "version": "0.0.1",
    "description": "",
    "main": ".dist/index.js",
    "module": ".dist/index.mjs",
    "types": ".dist/index.d.ts",
    "scripts": {
        "build:code": "tsup",
        "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
        "build": "npm run build:code && npm run build:css",
        "dev": "tsup --watch & tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch"
    },
    "keywords": [
        "Waanverse",
        "PhoneNumberInput"
    ],
    "author": "Waanverse Labs",
    "license": "ISC",
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/forms": "^0.5.11",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "tsup": "^8.5.1",
        "typescript": "^5.7.3"
    },
    "homepage": "https://www.waanverse.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/Waanverse/Waanverse-PhoneNumberInput"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    }
}
