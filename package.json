{
    "name": "waanverse-phonenumber-input",
    "description": "A sleek, highly customizable React phone number input component with real-time formatting, country flag support, and optimized custom styling.",
    "author": "Waanverse Labs Inc. <support@waanverse.com> (https://www.waanverse.com)",
    "contributors": [
        "Pattawee K. Drake <tawee@waanverse.com>"
    ],
    "keywords": [
        "react",
        "phone-input",
        "phone-number",
        "international-phone-input",
        "tailwind",
        "tailwindcss-v4",
        "country-flags",
        "google-libphonenumber",
        "typescript",
        "form-validation",
        "waanverse",
        "waanverse labs"
    ],
    "version": "0.0.1",
    "main": ".dist/index.js",
    "module": ".dist/index.mjs",
    "types": ".dist/index.d.ts",
    "scripts": {
        "build:code": "tsup && tsc",
        "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
        "build": "npm run build:code && npm run build:css",
        "dev": "tsup --watch & tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch"
    },
    "license": "MIT",
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "@tailwindcss/forms": "^0.5.11",
        "@types/google-libphonenumber": "^7.4.31",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "tsup": "^8.5.1",
        "typescript": "^5.7.3"
    },
    "homepage": "https://www.waanverse.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/Waanverse/Waanverse-PhoneNumberInput"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./dist/styles.css": "./dist/styles.css"
    },
    "dependencies": {
        "google-libphonenumber": "^3.2.46"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    }
}
